<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:csvw="http://www.w3.org/ns/csvw#"
  xmlns:dc="http://purl.org/dc/terms/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/">

  <!-- EFU CSVW Schema v0.3 (conceptual resource) -->
  <csvw:Table rdf:about="https://schema.moukaeritai.work/efu/0.3">

    <dc:hasVersion>0.3</dc:hasVersion>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">
      2025-12-19
    </dc:issued>

    <dc:description>
      Draft CSVW schema for Everything EFU file lists. Version 0.3 includes observation metadata and content hashes/checksums.
    </dc:description>

    <csvw:url rdf:resource="filelist.efu"/>

    <!-- Creator (provenance) -->
    <dc:creator>
      <foaf:Person>
        <foaf:name>Takashi Sasaki</foaf:name>
        <foaf:homepage rdf:resource="https://x.com/TakashiSasaki"/>
      </foaf:Person>
    </dc:creator>

    <!-- Table schema -->
    <csvw:tableSchema>
      <csvw:TableSchema>

        <csvw:columns>
          <rdf:Seq>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Filename</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  true
                </csvw:required>
                <dc:description>
                  Path or filename (usually absolute Windows path). (Everything default column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Size</csvw:name>
                <csvw:datatype>integer</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File size in bytes. (Everything default column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Date Modified</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Timestamp; Windows FILETIME (decimal) or ISO 8601 date-time. (Everything default column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Date Created</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Timestamp; Windows FILETIME (decimal) or ISO 8601 date-time. (Everything default column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Attributes</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Windows file attribute flags (decimal or 0x-prefixed hex). (Everything default column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Date Accessed</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Timestamp; Windows FILETIME (decimal) or ISO 8601 date-time. (Everything extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Run Count</csvw:name>
                <csvw:datatype>integer</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Number of times the file has been run/opened from Everything. (Everything extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Date Run</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Timestamp of the last run; Windows FILETIME (decimal) or ISO 8601 date-time. (Everything extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Type</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File type description or extension. (Everything extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>MD5</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File content MD5 hash (hexadecimal). (Everything 1.5+ extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>SHA-1</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File content SHA-1 hash (hexadecimal). (Everything 1.5+ extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>SHA-256</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File content SHA-256 hash (hexadecimal). (Everything 1.5+ extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>CRC-32</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File content CRC-32 checksum (hexadecimal; standard IEEE 802.3). (Everything 1.5+ extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>CRC-64</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  File content CRC-64 checksum (hexadecimal; ECMA-182). (Everything 1.5+ extended column)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Git Blob SHA-1</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Git blob object hash (SHA-1). Calculated as sha1("blob " + size + "\\0" + content). (Schema-defined metadata; ignored by Everything)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Git Blob SHA-256</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Git blob object hash (SHA-256). Future-proof for Git transition to SHA-256. (Schema-defined metadata; ignored by Everything)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Seen Date</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Timestamp when the file record was observed/collected. (Schema-defined metadata; ignored by Everything)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Seen Host</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Hostname or machine name where the file was observed. (Schema-defined metadata; ignored by Everything)
                </dc:description>
              </csvw:Column>
            </rdf:li>

            <rdf:li>
              <csvw:Column>
                <csvw:name>Seen User</csvw:name>
                <csvw:datatype>string</csvw:datatype>
                <csvw:required rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">
                  false
                </csvw:required>
                <dc:description>
                  Username of the user who observed/collected the record. (Schema-defined metadata; ignored by Everything)
                </dc:description>
              </csvw:Column>
            </rdf:li>

          </rdf:Seq>
        </csvw:columns>

      </csvw:TableSchema>
    </csvw:tableSchema>

  </csvw:Table>

</rdf:RDF>